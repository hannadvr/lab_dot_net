<Window x:Class="ClusterTelemetryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DevOps Моніторинг Кластерів"
        Height="620" Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхня панель: вибір JSON та імпорт в SQLite -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,12"
                BorderBrush="#DCE1E7" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="JSON-файл:" VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="0,0,10,0"/>

                <TextBox x:Name="FilePathTextBox" Grid.Column="1" IsReadOnly="True"
                         VerticalContentAlignment="Center" Padding="8,5"
                         Background="#F9FAFC" BorderBrush="#CBD2D9"/>

                <Button x:Name="BrowseButton" Grid.Column="2" Content="Обрати JSON..."
                        Click="BrowseButton_Click" Padding="14,6" Margin="10,0,0,0"
                        Background="#E4E7EB" FontWeight="SemiBold" Cursor="Hand"/>

                <Button x:Name="ImportButton" Grid.Column="3" Content="Імпортувати в БД"
                        Click="ImportButton_Click" Padding="16,6" Margin="10,0,0,0"
                        Background="#2563EB" Foreground="White" FontWeight="SemiBold" Cursor="Hand"/>

                <Button x:Name="CancelButton" Grid.Column="4" Content="Скасувати"
                        Click="CancelButton_Click" IsEnabled="False" Padding="12,6" Margin="8,0,0,0"
                        Background="#DC2626" Foreground="White" FontWeight="SemiBold" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Панель перемикання аналітичних запитів -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12"
                BorderBrush="#DCE1E7" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="LINQ-Аналітика:" VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="0,0,12,0"/>

                <Button Content="1. CPU Аномалії (>85%)" Click="ShowCpuAnomalies_Click"
                        Padding="12,6" Margin="0,0,8,0" Background="#FEF2F2" BorderBrush="#FCA5A5" Cursor="Hand"/>

                <Button Content="2. Зведення по кластерах" Click="ShowClusterSummary_Click"
                        Padding="12,6" Margin="0,0,8,0" Background="#EFF6FF" BorderBrush="#93C5FD" Cursor="Hand"/>

                <Button Content="3. Аналіз за версіями ОС" Click="ShowOsPerformance_Click"
                        Padding="12,6" Margin="0,0,8,0" Background="#F0FDF4" BorderBrush="#86EFAC" Cursor="Hand"/>

                <Button Content="4. Рейтинг ризику нод" Click="ShowNodeRisk_Click"
                        Padding="12,6" Margin="0,0,8,0" Background="#FFFBEB" BorderBrush="#FCD34D" Cursor="Hand"/>

                <Button Content="Усі метрики" Click="ShowAllMetrics_Click"
                        Padding="12,6" Background="#F3F4F6" BorderBrush="#D1D5DB" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Таблиця виводу результатів -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="10"
                BorderBrush="#DCE1E7" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="ReportTitleTextBlock" Grid.Row="0"
                           Text="Оберіть або імпортуйте файл для перегляду даних"
                           FontSize="15" FontWeight="Bold" Foreground="#1F2937" Margin="4,0,0,10"/>

                <DataGrid x:Name="AnalyticsDataGrid" Grid.Row="1"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          AlternatingRowBackground="#F8FAFC"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E5E7EB"
                          RowHeight="28"
                          ColumnWidth="*"/>
            </Grid>
        </Border>

        <!-- Статус-бар -->
        <StatusBar Grid.Row="3" Margin="0,10,0,0" Background="Transparent">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Готово до роботи." Foreground="#4B5563"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>