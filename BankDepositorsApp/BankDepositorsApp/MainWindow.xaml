<Window x:Class="BankDepositorsApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Список вкладників банку" Height="620" Width="870"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Блок додавання -->
        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,10">
            <TextBlock Text="Додати вкладника" FontWeight="Bold" Margin="0,0,0,5"/>
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="ПІБ:" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="FullNameTextBox" Grid.Row="0" Grid.Column="1" Margin="5" Padding="2"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="№ рахунку (IBAN):" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="AccountNumberTextBox" Grid.Row="0" Grid.Column="3" Margin="5" Padding="2"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Сума (грн):" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="AmountTextBox" Grid.Row="1" Grid.Column="1" Margin="5" Padding="2"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="Рік відкриття:" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="OpeningYearTextBox" Grid.Row="1" Grid.Column="3" Margin="5" Padding="2"/>
            </Grid>
            <Button x:Name="AddButton" Content="Додати вкладника" Margin="5,5,5,0" Click="AddButton_Click"/>
        </StackPanel>

        <!-- Таблиця даних -->
        <DataGrid x:Name="DepositorsDataGrid" Grid.Row="1"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Margin="0,5,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ПІБ" Binding="{Binding FullName}" Width="2*"/>
                <DataGridTextColumn Header="№ рахунку (IBAN)" Binding="{Binding AccountNumber}" Width="2*"/>
                <DataGridTextColumn Header="Сума" Binding="{Binding Amount, StringFormat={}{0:N2} грн}" Width="*"/>
                <DataGridTextColumn Header="Рік відкриття" Binding="{Binding OpeningYear}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Блок управління -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <Button x:Name="CurrentYearFilterButton" Content="Фільтр за поточним роком" Margin="5" Click="CurrentYearFilterButton_Click"/>
            <Button x:Name="ResetFilterButton" Content="Скинути фільтр" Margin="5" Click="ResetFilterButton_Click"/>
            <Button x:Name="SortButton" Content="Сортувати за сумою" Margin="5" Click="SortButton_Click"/>
            <Button x:Name="DeleteButton" Content="Видалити" Margin="5" Click="DeleteButton_Click"/>
            <Button x:Name="LoadButton" Content="Завантажити" Margin="5" Click="LoadButton_Click"/>
            <Button x:Name="SaveButton" Content="Зберегти" Margin="5" Click="SaveButton_Click"/>
        </StackPanel>

        <!-- Нова панель LINQ запитів -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5" Background="#FF119A7A">
            <TextBlock Text="Пошук:" VerticalAlignment="Center" Margin="5" Foreground="White"/>
            <TextBox x:Name="SearchTextBox" Width="130" Margin="5" Padding="2" VerticalAlignment="Center"/>
            <Button x:Name="SearchButton" Content="Пошук" Margin="5" Click="SearchButton_Click" Background="#FFD7FAB2" Padding="5,2"/>
            <Button x:Name="UniqueDepositorsButton" Content="Унікальні вкладники" Margin="5" Click="UniqueDepositorsButton_Click" Background="#FFD7FAB2" Padding="5,2"/>
            <Button x:Name="TopThreeButton" Content="Топ-3 вклади" Margin="5" Click="TopThreeButton_Click" Background="#FFD7FAB2" Padding="5,2"/>
            <Button x:Name="AverageAmountButton" Content="Середній вклад" Margin="5" Click="AverageAmountButton_Click" Background="#FFD7FAB2" Padding="5,2"/>
            <Button x:Name="GroupByYearButton" Content="Групування за роком" Margin="5" Click="GroupByYearButton_Click" Background="#FFD7FAB2" Padding="5,2"/>
        </StackPanel>
    </Grid>
</Window>