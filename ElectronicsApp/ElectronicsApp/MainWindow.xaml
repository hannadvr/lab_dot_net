<Window x:Class="ElectronicsApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ElectronicsApp"
        mc:Ignorable="d"
        Title="Облік електроніки" Height="480" Width="820" Foreground="#FF252D35" Background="#FFD8FDBE" FontFamily="Cascadia Code">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,15,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="670*"/>
            <ColumnDefinition Width="111*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхній блок: Введення даних -->
        <GroupBox Header="Нова техніка" Grid.Row="0" Margin="5,5,5,5" Grid.ColumnSpan="2">
            <StackPanel Orientation="Vertical" Margin="10">
                <Label Content="Тип техніки:"/>
                <ComboBox x:Name="DeviceTypeComboBox" Width="200" HorizontalAlignment="Left" SelectionChanged="DeviceTypeComboBox_SelectionChanged">
                    <ComboBoxItem Content="Телефон"/>
                    <ComboBoxItem Content="Ноутбук"/>
                </ComboBox>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Підписи полів зліва -->
                    <StackPanel Grid.Column="0">
                        <Label Content="Бренд:"/>
                        <Label Content="Ціна:"/>
                        <Label Content="Рік випуску:"/>

                        <!-- Специфічний підпис для Телефону -->
                        <StackPanel x:Name="PhoneFields">
                            <Label Content="Об'єм пам'яті (ГБ):"/>
                        </StackPanel>

                        <!-- Специфічний підпис для Ноутбука -->
                        <StackPanel x:Name="LaptopFields" Visibility="Collapsed">
                            <Label Content="Розмір екрану (дюйми):"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Текстові поля справа -->
                    <StackPanel Grid.Column="1">
                        <TextBox x:Name="BrandTextBox" Margin="0,3,0,3"/>
                        <TextBox x:Name="PriceTextBox" Margin="0,3,0,3"/>
                        <TextBox x:Name="YearTextBox" Margin="0,3,0,3"/>
                        <TextBox x:Name="RamMemoryTextBox" Margin="0,3,0,3"/>
                        <TextBox x:Name="ScreenSizeTextBox" Margin="0,3,0,3" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>

                <Button x:Name="AddDeviceButton" Content="Додати техніку" Margin="0,15,0,0" HorizontalAlignment="Left" Padding="10,5" Click="AddDeviceButton_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- Середній блок: Список техніки -->
        <ListBox x:Name="ElectronicsListBox" Grid.Row="1" Grid.ColumnSpan="2" Margin="5"/>

        <!-- Нижній блок: Загальний розрахунок та аналітика -->
        <GroupBox Header="Аналітика" Grid.Row="2" Margin="5,5,5,5" Grid.ColumnSpan="2">
            <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Center">
                <TextBlock Text="Загальна амортизація: " FontWeight="Bold"/>
                <TextBlock x:Name="TotalDepreciationTextBlock" Text="0.00 грн"/>
                <TextBlock Text="  |  "/>
                <TextBlock Text="Кількість техніки: " FontWeight="Bold"/>
                <TextBlock x:Name="TotalCountTextBlock" Text="0"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>