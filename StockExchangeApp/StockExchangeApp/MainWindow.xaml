<Window x:Class="StockExchangeApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Симулятор Фондової Біржі" Height="480" Width="700"
        Background="#1E293B" Foreground="White">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель керування -->
        <GroupBox Header="Панель керування біржею (Початкова ціна: 75.00$)" 
                  Foreground="#38BDF8" FontWeight="Bold" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Нова ціна нафти ($):" VerticalAlignment="Center" Foreground="White" Margin="0,0,10,0"/>
                <TextBox x:Name="txtOilPrice" Width="100" Height="28" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,10,0"/>
                <Button x:Name="btnUpdatePrice" Content="Оновити котирування" Width="150" Height="28" 
                        Background="#0284C7" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"
                        Click="btnUpdatePrice_Click"/>
                <Button x:Name="btnCloseMarket" Content="Закрити ринок" Width="120" Height="28" 
                        Background="#DC2626" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"
                        Click="btnCloseMarket_Click"/>
                <Button x:Name="btnOpenMarket" Content="Відкрити" Width="80" Height="28" 
                        Background="#16A34A" Foreground="White" FontWeight="Bold"
                        Click="btnOpenMarket_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- Журнал подій -->
        <GroupBox Grid.Row="1" Header="Журнал біржових подій" Foreground="#38BDF8" FontWeight="Bold" Padding="10">
            <ListBox x:Name="LogListBox" Background="#0F172A" Foreground="#E2E8F0" FontFamily="Consolas" FontSize="13"/>
        </GroupBox>
    </Grid>
</Window>